---
interface Props {
  alt: string;
  src: string;
  url: string;
}

const { alt, src, url } = Astro.props;
---

<figure class="overflow-hidden rounded-2xl bg-card ring-1 ring-white/10">
  <div
    class="flex h-9 items-center gap-2 border-b border-white/10 bg-[#1a1a1a] px-3"
  >
    <span class="size-2 rounded-full bg-white/25"></span>
    <span class="size-2 rounded-full bg-white/25"></span>
    <span class="size-2 rounded-full bg-white/25"></span>
    <span class="ml-2 truncate font-mono text-xs text-white/45">{url}</span>
  </div>
  <img
    alt={alt}
    class="aspect-video w-full object-cover object-top"
    decoding="async"
    height="900"
    loading="lazy"
    src={src}
    width="1440"
  >
</figure>
