---
import BrowserFrame from "@/components/home/browser-frame.astro";
import SectionHeading from "@/components/home/section-heading.astro";
import SiteContainer from "@/components/layout/site-container.astro";
import { Button } from "@/components/starwind/button";
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import BaseLayout from "@/layouts/base-layout.astro";

const services = [
  {
    description:
      "Worship slides, bilingual welcome graphics, bulletins, and brand systems that look like your church — not a stock template.",
    href: "#work",
    id: "graphic-design",
    title: "Graphic design",
  },
  {
    description:
      "Church websites with visit flows, service times, and gospel pages. English and Spanish when the congregation needs both.",
    href: "#work",
    id: "websites",
    title: "Website services",
  },
  {
    description:
      "A staff portal built around how your ministry actually runs — orders of service, teams, and reminders. Start lean; grow the feature set as you grow.",
    href: "#portal",
    id: "staff-management",
    title: "Staff & church service management",
  },
] as const;

const clients = [
  {
    alt: "Iglesia Bautista Victory homepage with Spanish headline and Fresno skyline",
    href: "https://iglesiafresno.com",
    id: "iglesia",
    image: "/images/client-iglesiafresno.webp",
    name: "Iglesia Bautista Victory",
    note: "Spanish-language church site — visit flows, gospel, and team pages.",
    url: "iglesiafresno.com",
  },
  {
    alt: "Victory Baptist Church homepage with Grow in faith headline",
    href: "https://fresnovictory.com",
    id: "vbc",
    image: "/images/client-fresnovictory.webp",
    name: "Victory Baptist Church",
    note: "English church site — sermons, ministries, events, and visit planning.",
    url: "fresnovictory.com",
  },
] as const;

const graphics = [
  {
    alt: "Sample Sunday morning worship lyric slide for Amazing Grace",
    caption: "Worship lyric slide",
    id: "lyric",
    src: "/images/graphic-slide.webp",
  },
  {
    alt: "Sample bilingual welcome graphic with Sunday and Thursday service times",
    caption: "Bilingual welcome graphic",
    id: "welcome",
    src: "/images/graphic-welcome.webp",
  },
] as const;

const portalShots = [
  {
    alt: "Church staff portal dashboard showing upcoming Sunday, planning counts, and serving teams",
    caption: "One dashboard for Sunday — who’s planning, who’s serving, what’s still open",
    id: "dashboard",
    src: "/images/portal-dashboard.webp",
  },
  {
    alt: "Order of service editor with activities, hymns, and assigned teams",
    caption: "Build the order of service once — hymns, activities, and team assignments in one place",
    id: "order",
    src: "/images/portal-order.webp",
  },
  {
    alt: "Team reminder screen with role-based contacts and call times",
    caption: "Remind the right people at the right time — roles, call times, automatic follow-through",
    id: "reminders",
    src: "/images/portal-reminders.webp",
  },
] as const;

const mediaTools = [
  {
    description:
      "HDMI, SDI, and network runs dressed for the booth, platform, and screens — built to last a church week, not a one-off event.",
    id: "cabling",
    title: "Video & cabling",
  },
  {
    description:
      "Worship lyrics, scripture, and announcement look — configured and trained for the volunteers who actually run Sunday.",
    id: "propresenter",
    title: "ProPresenter",
  },
  {
    description:
      "Presentation for congregations already on Proclaim — we set up the workflow so media is not a second job.",
    id: "proclaim",
    title: "Proclaim",
  },
] as const;

const applets = [
  {
    description:
      "Remind Media at 7:00 AM and Worship at 8:30 AM with the published order of service.",
    id: "sunday",
    swatch: "bg-sky-500",
    title: "If Sunday is tomorrow",
  },
  {
    description:
      "Send that team’s contact group the plan, hymns, and call time — no extra text thread.",
    id: "assigned",
    swatch: "bg-amber-400",
    title: "If a role is assigned",
  },
  {
    description:
      "Queue a next-day reminder for pastoral staff. Follow-up does not depend on someone remembering.",
    id: "guest",
    swatch: "bg-emerald-500",
    title: "If a guest card is complete",
  },
] as const;

const cyberItems = [
  {
    description:
      "Endpoint protection sized for church offices and volunteer laptops.",
    id: "antivirus",
    title: "Antivirus",
  },
  {
    description:
      "Network edge that belongs to the church, with rules you can explain to a trustee board.",
    id: "firewall",
    title: "Firewalls",
  },
  {
    description:
      "Keep campus Wi-Fi and staff browsing in a lane that fits a house of worship.",
    id: "filtering",
    title: "Web-content filtering",
  },
] as const;
---

<BaseLayout
  description="Bespoke church technology — websites, design, media, and staff tools sized to your ministry, not a one-size-fits-all suite."
  title="Zenitram Solutions — Technology for the local church"
>
  <section
    aria-labelledby="hero-heading"
    class="relative isolate min-h-[min(92svh,52rem)] overflow-hidden"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div
        class="absolute top-[48%] left-1/2 size-[42rem] -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/8 sm:size-[54rem] md:size-[68rem]"
      ></div>
      <div
        class="absolute top-[48%] left-1/2 size-[28rem] -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/8 sm:size-[38rem] md:size-[48rem]"
      ></div>
      <div
        class="absolute top-[48%] left-1/2 size-[16rem] -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/10 sm:size-[22rem] md:size-[28rem]"
      ></div>
    </div>

    <SiteContainer
      class="site-gutter relative flex min-h-[min(92svh,52rem)] flex-col items-center justify-center py-24 text-center md:py-32"
    >
      <div class="max-w-3xl animate-fade-up">
        <p
          class="mb-5 font-heading font-semibold text-sm text-white/70 uppercase tracking-[0.16em] sm:text-base"
        >
          Zenitram Solutions
        </p>
        <h1
          class="font-extrabold font-heading text-4xl text-balance text-white tracking-tight sm:text-6xl md:text-7xl md:leading-[1.05]"
          id="hero-heading"
        >
          Technology for the local church.
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-base text-white/70 sm:text-lg">
          Bespoke websites, design, media, and staff tools — built for your
          ministry, not a bloated one-size-fits-all suite. Only what you need
          now; add more as you grow.
        </p>
        <div
          class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
        >
          <Button href="#contact" size="lg" variant="default">
            Talk with us
          </Button>
          <Button href="#work" size="lg" variant="outline">
            See the work
          </Button>
        </div>
      </div>
    </SiteContainer>
  </section>

  <section
    aria-labelledby="services-heading"
    class="site-gutter border-t border-border py-24 md:py-32"
    id="services"
  >
    <SiteContainer>
      <SectionHeading
        description="Custom work for houses of worship — not cookie-cutter packages. Start with what Sunday needs; expand when your ministry does."
        eyebrow="Services"
        headingId="services-heading"
        title="Built for your congregation."
      />
      <div class="grid gap-6 md:grid-cols-3">
        {services.map((service) => (
            <a class="group" href={service.href}>
              <Card class="h-full bg-card/80 transition-colors duration-300 hover:bg-card">
                <CardHeader>
                  <CardTitle>{service.title}</CardTitle>
                  <CardDescription>{service.description}</CardDescription>
                </CardHeader>
              </Card>
            </a>
          ))}
      </div>
    </SiteContainer>
  </section>

  <section
    aria-labelledby="work-heading"
    class="site-gutter border-t border-border py-24 md:py-32"
    id="work"
  >
    <SiteContainer>
      <SectionHeading
        description="Live church sites we design and maintain. Graphic work for the same congregations — slides, welcome pieces, bilingual layouts."
        eyebrow="Work"
        headingId="work-heading"
        title="Churches we serve."
      />

      <div class="grid gap-10 lg:grid-cols-2">
        {clients.map((client) => (
            <article>
              <BrowserFrame alt={client.alt} src={client.image} url={client.url} />
              <h3 class="mt-5 font-bold font-heading text-2xl tracking-tight">
                <a
                  class="transition-opacity hover:opacity-80"
                  href={client.href}
                  rel="noreferrer"
                  target="_blank"
                >
                  {client.name}
                </a>
              </h3>
              <p class="mt-2 text-muted-foreground">{client.note}</p>
            </article>
          ))}
      </div>

      <div class="mt-20">
        <h3 class="font-bold font-heading text-2xl tracking-tight">
          Graphic design examples
        </h3>
        <p class="mt-2 max-w-2xl text-muted-foreground">
          Lyric slides and bilingual welcome layouts designed for the same
          congregations — on-brand, ready for Sunday.
        </p>
        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          {graphics.map((graphic) => (
              <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
                <img
                  alt={graphic.alt}
                  class="aspect-video w-full object-cover"
                  decoding="async"
                  height="900"
                  loading="lazy"
                  src={graphic.src}
                  width="1440"
                />
                <figcaption class="border-white/10 border-t px-4 py-3 text-muted-foreground text-sm">
                  {graphic.caption}
                </figcaption>
              </figure>
            ))}
        </div>
      </div>
    </SiteContainer>
  </section>

  <section
    aria-labelledby="portal-heading"
    class="site-gutter border-t border-border py-24 md:py-32"
    id="portal"
  >
    <SiteContainer>
      <SectionHeading
        description="A bespoke staff portal for the people who make Sunday happen — order of service, serving teams, and reminders in one place. No bloated church suite. You get the workflows your ministry needs, and we add features as you grow."
        eyebrow="Staff portal"
        headingId="portal-heading"
        title="Sunday, coordinated — without the bloat."
      />
      <div class="grid gap-8">
        {portalShots.map((shot) => (
            <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
              <img
                alt={shot.alt}
                class="w-full"
                decoding="async"
                height="900"
                loading="lazy"
                src={shot.src}
                width="1440"
              />
              <figcaption class="border-white/10 border-t px-4 py-3 text-muted-foreground text-sm">
                {shot.caption}
              </figcaption>
            </figure>
          ))}
      </div>
    </SiteContainer>
  </section>

  <section
    aria-labelledby="media-heading"
    class="site-gutter border-t border-border py-24 md:py-32"
    id="media"
  >
    <SiteContainer>
      <SectionHeading
        description="Screens, cabling, and presentation software so the room and the stream stay together."
        eyebrow="Media"
        headingId="media-heading"
        title="What the congregation sees."
      />
      <div class="grid gap-6 md:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
          <img
            alt="Church sanctuary with LED wall, side screens, and a media booth with mixer and camera"
            class="aspect-video w-full object-cover"
            decoding="async"
            height="720"
            loading="lazy"
            src="/images/media-sanctuary.webp"
            width="1280"
          >
        </figure>
        <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
          <img
            alt="Dressed network and AV rack with switch, UPS, and patch cables"
            class="aspect-video w-full object-cover"
            decoding="async"
            height="720"
            loading="lazy"
            src="/images/media-rack.webp"
            width="1280"
          >
        </figure>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {mediaTools.map((tool) => (
            <Card>
              <CardHeader>
                <CardTitle>{tool.title}</CardTitle>
                <CardDescription>{tool.description}</CardDescription>
              </CardHeader>
            </Card>
          ))}
      </div>
    </SiteContainer>
  </section>

  <section
    aria-labelledby="zenith-heading"
    class="site-gutter border-t border-border py-24 md:py-32"
    id="zenith-cast"
  >
    <SiteContainer>
      <SectionHeading
        description="A Zenitram Solutions app for organizations that need lyrics, scripture, and announcements on a screen — without seat licenses, monthly plans, or a vendor login to preach."
        eyebrow="Coming soon"
        headingId="zenith-heading"
        title="Zenith Cast."
      />
      <figure class="overflow-hidden rounded-2xl ring-1 ring-white/10">
        <img
          alt="Zenith Cast operator view with live lyric output and next-slide queue"
          class="w-full"
          decoding="async"
          height="900"
          loading="lazy"
          src="/images/zenith-cast.webp"
          width="1440"
        >
      </figure>
      <p class="mt-6 max-w-2xl text-muted-foreground">
        Built for churches and similar organizations that want a low-cost
        presentation path: local control, multiple outputs, and no subscription
        tax. ProPresenter and Proclaim remain supported where they already fit.
      </p>
    </SiteContainer>
  </section>

  <section
    aria-labelledby="agentic-heading"
    class="site-gutter border-t border-border py-24 md:py-32"
    id="agentic"
  >
    <SiteContainer>
      <SectionHeading
        description="Reminders and contact workflows that fit how your teams already serve — not another app everyone ignores. Turn on the automations you need; leave the rest off until ministry scale demands them."
        eyebrow="Agentic tools"
        headingId="agentic-heading"
        title="If this Sunday, then that reminder."
      />
      <div class="grid gap-6 md:grid-cols-3">
        {applets.map((applet) => (
            <Card>
              <CardHeader>
                <span
                  class:list={[
                    "mb-4 inline-block size-10 rounded-lg",
                    applet.swatch,
                  ]}
                />
                <CardTitle>{applet.title}</CardTitle>
                <CardDescription>{applet.description}</CardDescription>
              </CardHeader>
            </Card>
          ))}
      </div>
    </SiteContainer>
  </section>

  <section
    aria-labelledby="cyber-heading"
    class="site-gutter border-t border-border py-24 md:py-32"
    id="cyber"
  >
    <SiteContainer>
      <SectionHeading
        description="Church offices, volunteer devices, and campus Wi-Fi need a quieter kind of hardening. This line is on the way."
        eyebrow="Coming soon"
        headingId="cyber-heading"
        title="Cybersecurity for church organizations."
      />
      <div class="grid gap-6 md:grid-cols-3">
        {cyberItems.map((item) => (
            <Card>
              <CardHeader>
                <p class="mb-2 font-semibold text-muted-foreground text-xs uppercase tracking-[0.14em]">
                  Coming soon
                </p>
                <CardTitle>{item.title}</CardTitle>
                <CardDescription>{item.description}</CardDescription>
              </CardHeader>
            </Card>
          ))}
      </div>
    </SiteContainer>
  </section>

  <section
    aria-labelledby="contact-heading"
    class="site-gutter border-t border-border py-24 md:py-32"
    id="contact"
  >
    <SiteContainer class="max-w-2xl">
      <h2
        class="font-extrabold font-heading text-3xl tracking-tight sm:text-4xl md:text-5xl"
        id="contact-heading"
      >
        Tell us what Sunday needs.
      </h2>
      <p class="mt-6 text-base text-muted-foreground sm:text-lg">
        A site, a booth, a portal, or a presentation stack — scoped to what you
        need now, ready to grow with the ministry. We will follow up by email.
      </p>
      <div class="mt-8">
        <Button
          href="mailto:francisco@zenitram.dev"
          size="lg"
          variant="default"
        >
          Email francisco@zenitram.dev
        </Button>
      </div>
    </SiteContainer>
  </section>
</BaseLayout>
